# Express API
PORT=4000
# Comma-separated list of allowed browser origins (development + production).
CLIENT_ORIGIN=http://localhost:5173

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only key. Never expose this through Vite or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI campus brief (uses Gemma). Server-only: never prefix with VITE_ and never
# commit a real key. Get a free key at https://aistudio.google.com/apikey
# (Google AI Studio serves Gemma models over the Gemini API).
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the Gemma model (default: gemma-4-26b-a4b-it).
# GEMINI_MODEL=gemma-4-26b-a4b-it

# Optional: run Gemma locally with Ollama instead of the cloud.
# Start `ollama serve` and `ollama pull gemma3:4b`, then set this base URL.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b

# Frontend (set in the Vercel project, not the backend). Must include /api.
# VITE_API_URL=https://your-backend.onrender.com/api
